# Copy this file to .env.local and fill in real values.
# .env.local is gitignored. Never commit real secrets.

# ---------- Firebase (client SDK — safe to expose) ----------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------- Firebase Admin (server-only) ----------
# Get these from a service-account JSON in Firebase console.
# The private key contains literal "\n" sequences — keep them as written.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# ---------- Flutterwave (TEST keys only) ----------
FLW_PUBLIC_KEY=FLWPUBK_TEST-
FLW_SECRET_KEY=FLWSECK_TEST-
FLW_SECRET_HASH=

# ---------- Africa's Talking ----------
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=LEMONPAY

# ---------- Lira integration ----------
LIRA_API_BASE=
LIRA_SHARED_SECRET=

# ---------- Demo controls ----------
DEMO_RESET_TOKEN=lp_demo_replace_me
NEXT_PUBLIC_DEMO_MODE=true

# ---------- OTP / JWT ----------
# Used to sign short-lived verification tokens returned by /api/otp/verify.
OTP_JWT_SECRET=
